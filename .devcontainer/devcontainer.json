{
    "name": "Oracle Database Learning Container",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "hostRequirements": {
        "memory": "8gb",
        "cpus": 4
    },
    "forwardPorts": [1521, 5500],
    "portsAttributes": {
        "1521": {
            "label": "Oracle Listener (TNS)",
            "onAutoForward": "silent"
        },
        "5500": {
            "label": "EM Express",
            "onAutoForward": "notify"
        }
    },
    "containerEnv": {
        "ORACLE_BASE": "/opt/oracle",
        "ORACLE_HOME": "/opt/oracle/product/21c/dbhomeXE",
        "ORACLE_SID": "XE",
        "ORACLE_HOSTNAME": "$(hostname)"
    },
    "postCreateCommand": "echo \"127.0.0.1 $(hostname)\" | sudo tee -a /etc/hosts && mkdir -p ~/scripts ~/data ~/logs",
    "customizations": {
        "vscode": {
            "extensions": [
                "oracle.sql-developer",
                "ms-azuretools.vscode-docker",
                "vscjava.vscode-java-pack",
                "redhat.vscode-yaml",
                "anthropic.claude-code",
                "mermaidchart.vscode-mermaid-chart"
            ]
        }
    },
    "remoteUser": "oracle"
}
